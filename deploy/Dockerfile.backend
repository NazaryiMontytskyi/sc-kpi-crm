# Backend image. Build context: repository root.  docker build -f deploy/Dockerfile.backend .
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /build
COPY pom.xml ./
RUN mvn -B -q dependency:go-offline
COPY src ./src
RUN mvn -B -q -DskipTests package && cp target/crm-*.jar /build/app.jar

FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /app crm \
 && mkdir -p /app /var/lib/crm/files && chown -R crm:crm /app /var/lib/crm
WORKDIR /app
COPY --from=build --chown=crm:crm /build/app.jar app.jar
USER crm
ENV SPRING_PROFILES_ACTIVE=prod \
    CRM_FILES_ROOT=/var/lib/crm/files \
    JAVA_TOOL_OPTIONS="-Duser.timezone=UTC -XX:MaxRAMPercentage=75"
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
