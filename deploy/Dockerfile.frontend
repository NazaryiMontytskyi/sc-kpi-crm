# Frontend image: Vite build -> nginx (SPA + reverse proxy). Build context: repository root.
# The build reads ../assets/brand (via import.meta.glob); when the folder is absent the text placeholders are used.
FROM node:22-alpine AS build
WORKDIR /repo
COPY . /repo
WORKDIR /repo/frontend
RUN npm ci && npm run build

FROM nginx:1.27-alpine
# nginx config templates are mounted by compose (deploy/nginx/*.conf.template) and rendered by envsubst at start.
COPY --from=build /repo/frontend/dist /usr/share/nginx/html
EXPOSE 80 443
