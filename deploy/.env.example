# Copy to .env (never commit .env). Placeholders only.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me

# First Admin account, created only when the users table is empty (INC-004). Empty = nothing is created.
# The operator MUST set a random, unique password of at least 10 characters (letter + digit) and a login; never reuse a published value.
# The password must satisfy the policy (>= 10 chars, letter + digit); the account must change it on first sign-in.
CRM_BOOTSTRAP_ADMIN_LOGIN=
CRM_BOOTSTRAP_ADMIN_PASSWORD=

# Files (INC-009): directory of the local file storage; mount a persistent Docker volume here.
CRM_FILES_ROOT=/var/lib/crm/files
# Optional: CRM_FILES_MAX_SIZE=20MB

# ---- Production stack (deploy/docker-compose.yml). All host-specific values are parameters; placeholders only. ----
# Public host name served by nginx (OPEN-Q9: owned by the university IT; "localhost" for local evaluation).
CRM_DOMAIN=localhost
# Published host ports of nginx.
HTTP_PORT=80
HTTPS_PORT=443
# nginx mode: http.conf.template (default) or https.conf.template (nginx terminates TLS).
NGINX_TEMPLATE=http.conf.template
# HTTPS mode only: host directory with the certificate and key (mounted read-only) and their file names.
TLS_CERT_DIR=./nginx/tls
TLS_CERT_FILE=fullchain.pem
TLS_KEY_FILE=privkey.pem

# Backups: BACKUP_TARGET is a host directory (absolute path, e.g. a mounted share) or empty for the named volume "backups".
BACKUP_TARGET=backups
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=02
