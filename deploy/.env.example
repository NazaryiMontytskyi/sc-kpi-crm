# Copy to .env (never commit .env). Placeholders only.
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=change-me

# First Admin account, created only when the users table is empty (INC-004). Empty = nothing is created.
# The operator MUST set a random, unique password of at least 10 characters (letter + digit) and a login; never reuse a published value.
# The password must satisfy the policy (>= 10 chars, letter + digit); the account must change it on first sign-in.
CRM_BOOTSTRAP_ADMIN_LOGIN=
CRM_BOOTSTRAP_ADMIN_PASSWORD=
