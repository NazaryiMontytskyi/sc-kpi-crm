{
  "openapi": "3.1.0",
  "info": {
    "title": "Student Council of KPI CRM API",
    "description": "Session cookie authentication. State-changing requests must send the XSRF-TOKEN cookie value in the X-XSRF-TOKEN header. Errors are RFC 7807 application/problem+json with a stable `code`.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Session sign-in, sign-out and the current user"
    },
    {
      "name": "Permissions",
      "description": "Permission catalog and effective permissions of users"
    }
  ],
  "paths": {
    "/api/v1/org-units/{id}": {
      "get": {
        "tags": [
          "Org structure"
        ],
        "summary": "Get one unit, including archived ones, with its ancestor ids and active child ids",
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrgUnitResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Org structure"
        ],
        "summary": "Rename a unit / change its description",
        "operationId": "update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrgUnitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrgUnitResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/faculties/{id}": {
      "get": {
        "tags": [
          "Faculties"
        ],
        "summary": "Get one faculty, including an archived one (existing profiles may reference it)",
        "operationId": "get_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FacultyResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Faculties"
        ],
        "summary": "Edit an active faculty",
        "operationId": "update_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FacultyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FacultyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/org-units": {
      "post": {
        "tags": [
          "Org structure"
        ],
        "summary": "Create a unit",
        "description": "Type/parent rules: LEADERSHIP has no parent and is unique; DEPARTMENT sits under LEADERSHIP or at top level; DIVISION requires a DEPARTMENT parent; WORKING_GROUP is outside the hierarchy (no parent or any active unit).",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrgUnitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrgUnitResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/org-units/{id}/restore": {
      "post": {
        "tags": [
          "Org structure"
        ],
        "summary": "Restore an archived unit",
        "description": "Requires an active parent.",
        "operationId": "restore",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrgUnitResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/org-units/{id}/move": {
      "post": {
        "tags": [
          "Org structure"
        ],
        "summary": "Move a unit under another parent (null = top level)",
        "description": "Rejects type-invalid parents and cycles.",
        "operationId": "move",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveOrgUnitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrgUnitResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/org-units/{id}/archive": {
      "post": {
        "tags": [
          "Org structure"
        ],
        "summary": "Archive a unit (soft)",
        "description": "Refused with 409 while the unit has active children or an archive guard vetoes it. Archiving a working group disbands it.",
        "operationId": "archive",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrgUnitResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files": {
      "post": {
        "tags": [
          "Files"
        ],
        "summary": "Upload a file",
        "description": "Multipart part `file`. The type is detected from the bytes and checked against the allow-list; the size is limited (default 20 MB).",
        "operationId": "upload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "file"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File stored",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FileResponse"
                }
              }
            }
          },
          "413": {
            "description": "FILE_TOO_LARGE",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "415": {
            "description": "FILE_TYPE_NOT_ALLOWED",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "FILE_EMPTY",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/faculties": {
      "get": {
        "tags": [
          "Faculties"
        ],
        "summary": "List faculties (paginated, sortable by code, nameUk, nameEn; default nameUk)",
        "description": "Active faculties only. includeArchived=true is honoured only for holders of settings.manage; for everyone else it is ignored.",
        "operationId": "list",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/PageParams"
            }
          },
          {
            "name": "includeArchived",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseFacultyResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Faculties"
        ],
        "summary": "Create a faculty",
        "description": "Code and both names are unique among active faculties, case-insensitively (409 otherwise).",
        "operationId": "create_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FacultyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FacultyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/faculties/{id}/restore": {
      "post": {
        "tags": [
          "Faculties"
        ],
        "summary": "Restore an archived faculty",
        "description": "409 if its code or a name is now used by an active faculty.",
        "operationId": "restore_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FacultyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/faculties/{id}/archive": {
      "post": {
        "tags": [
          "Faculties"
        ],
        "summary": "Archive a faculty (soft)",
        "description": "Allowed even when profiles use it: they keep the reference, the faculty just stops being selectable.",
        "operationId": "archive_1",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/FacultyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign out and invalidate the session (idempotent)",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in with login and password; creates an HttpOnly session cookie",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS (same answer for unknown login, wrong password, blocked or archived account)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "CSRF_INVALID",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "LOGIN_LOCKED: too many failed attempts; see Retry-After",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/change-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Change the own password (required when mustChangePassword is true)",
        "operationId": "changePassword",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password changed; mustChangePassword is now false",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "422": {
            "description": "CURRENT_PASSWORD_INVALID, PASSWORD_UNCHANGED or PASSWORD_POLICY_VIOLATION",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "LOGIN_LOCKED: too many wrong current passwords",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me/locale": {
      "patch": {
        "tags": [
          "Auth"
        ],
        "summary": "Persist the preferred UI language (uk or en)",
        "operationId": "changeLocale",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeLocaleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}/permissions": {
      "get": {
        "tags": [
          "Permissions"
        ],
        "summary": "Effective permissions of a user (self or roles.assign)",
        "operationId": "userPermissions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/UserPermissionsDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/permissions": {
      "get": {
        "tags": [
          "Permissions"
        ],
        "summary": "Permission catalog grouped as in CONTEXT.md 5.2, labels in the request locale",
        "operationId": "catalog",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PermissionGroupDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/org-units/tree": {
      "get": {
        "tags": [
          "Org structure"
        ],
        "summary": "Org tree",
        "description": "Forest of units (roots are units without a parent), siblings sorted by name. Archived units are hidden unless includeArchived=true.",
        "operationId": "tree",
        "parameters": [
          {
            "name": "includeArchived",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrgUnitTreeNode"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files/{id}": {
      "get": {
        "tags": [
          "Files"
        ],
        "summary": "Download a file",
        "description": "Streams the bytes. PDF and images are served inline, everything else as an attachment; archived files return 404.",
        "operationId": "download",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND (unknown or archived)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "The signed-in user (also answered while a password change is pending)",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED; the response still carries the XSRF-TOKEN cookie",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateOrgUnitRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": [
          "name"
        ]
      },
      "OrgUnitResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "LEADERSHIP",
              "DEPARTMENT",
              "DIVISION",
              "WORKING_GROUP"
            ]
          },
          "parentId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ancestorIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "childIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "FacultyRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 30,
            "minLength": 0,
            "pattern": "[A-Za-z0-9._-]+"
          },
          "nameUk": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "nameEn": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "code",
          "nameEn",
          "nameUk"
        ]
      },
      "FacultyResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "nameUk": {
            "type": "string"
          },
          "nameEn": {
            "type": "string"
          },
          "archived": {
            "type": "boolean"
          },
          "archivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateOrgUnitRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "type": {
            "type": "string",
            "enum": [
              "LEADERSHIP",
              "DEPARTMENT",
              "DIVISION",
              "WORKING_GROUP"
            ]
          },
          "parentId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          }
        },
        "required": [
          "name",
          "type"
        ]
      },
      "MoveOrgUnitRequest": {
        "type": "object",
        "properties": {
          "parentId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "FileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string",
            "description": "Sanitized original file name"
          },
          "mimeType": {
