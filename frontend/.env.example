# Copy to .env.local for local overrides. Placeholders only; never commit real values.

# Base URL of the backend API as seen by the browser. Empty = same origin (Vite proxy in dev, nginx in prod).
VITE_API_BASE_URL=

# Dev server proxy target for /api (Vite dev only).
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Live OpenAPI document used by `npm run api:fetch` (backend dev/test profile only).
OPENAPI_URL=http://localhost:8080/v3/api-docs
